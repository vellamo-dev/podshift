[Unit]
Description=Watch the PodShift drop directory for new files

[Path]
# systemd cannot read main.conf: this is PODSHIFT_DROP_DIR there, so change both together.
PathChanged=/home/podshift/drop
# See: [podshift-drop-debounce.service](<./podshift-drop-debounce.service>)
Unit=podshift-drop-debounce.service

[Install]
WantedBy=default.target
