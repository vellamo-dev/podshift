{
  "action": "quadlet-drop",
  "name": "Quadlet drop",
  "description": "Writes one uploaded Quadlet file (.container, .volume, .network, .image) or .zip bundle of at most 50 KB into the podshift drop directory, owned by podshift with mode 0644.",
  "status": "active",
  "input": {
    "type": "object",
    "properties": {
      "name": { "type": "string", "minLength": 1, "maxLength": 255 },
      "content": { "type": "string", "minLength": 4, "maxLength": 68268, "pattern": "\\A[A-Za-z0-9+/]+={0,2}\\z" }
    },
    "required": ["name", "content"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "name": { "type": "string" },
      "ok": { "type": "boolean" },
      "error": { "type": "string", "enum": ["INVALID_NAME", "UNSUPPORTED_TYPE", "INVALID_CONTENT", "EMPTY_FILE", "TOO_LARGE", "WRONG_OWNER", "NAME_BUSY", "DROP_UNAVAILABLE"] },
      "message": { "type": "string" }
    },
    "required": ["name", "ok"],
    "additionalProperties": false
  }
}
