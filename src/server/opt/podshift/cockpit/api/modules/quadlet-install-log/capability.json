{
  "action": "quadlet-install-log",
  "name": "Quadlet install log",
  "description": "Shows the last 100 journal entries of the podshift drop, validate, install and remove steps (podshift-drop-process, podshift-qdl-validate, podshift-qdl-install, podshift-qdl-remove) and the systemd and Podman lines of the Quadlet units they start, read as root.",
  "status": "active",
  "input": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "readable": { "type": "boolean" },
      "error": { "type": "string", "enum": ["JOURNAL_UNREADABLE"] },
      "reason": { "type": "string", "maxLength": 200 },
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "time": { "type": "string" },
            "hostname": { "type": "string" },
            "identifier": { "type": "string" },
            "pid": { "type": "integer" },
            "priority": { "type": "integer", "enum": [0, 1, 2, 3, 4, 5, 6, 7] },
            "message": { "type": "string" }
          },
          "required": ["time", "hostname", "identifier", "priority", "message"],
          "additionalProperties": false
        }
      }
    },
    "required": ["readable", "entries"],
    "additionalProperties": false
  }
}
