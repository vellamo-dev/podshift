#!/bin/sh
# Fake systemctl. is-active answers from STUB_DOCKER, STUB_NM_ACTIVE (default 1) and STUB_NETWORKD_ACTIVE.
case "$1" in
    get-default) echo "${STUB_TARGET:-multi-user.target}" ;;
    is-active)
        for last; do :; done
        case "${last}" in
            docker) [ "${STUB_DOCKER:-0}" = "1" ] && exit 0 ;;
            NetworkManager) [ "${STUB_NM_ACTIVE:-1}" = "1" ] && exit 0 ;;
            systemd-networkd) [ "${STUB_NETWORKD_ACTIVE:-0}" = "1" ] && exit 0 ;;
        esac
        exit 3 ;;
esac
