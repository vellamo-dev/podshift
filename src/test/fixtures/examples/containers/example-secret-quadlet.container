# Example Quadlet container that uses the example secrets (dev/test data only).
# example-db-password as an environment variable, example-api-token as a file. The secrets come from
# ../secrets/secrets.list, which postinstall-examples creates first.
[Unit]
Description=PodShift example Quadlet container with secrets

[Container]
ContainerName=example-secret-quadlet
Image=docker.io/library/alpine:latest
Exec=sleep infinity
Label=podshift.example=1
Secret=example-db-password,type=env,target=DB_PASSWORD
Secret=example-api-token,target=/run/secrets/api-token

[Install]
WantedBy=default.target
